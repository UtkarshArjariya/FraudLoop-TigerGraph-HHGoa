TG_HOST=http://localhost
TG_GRAPHNAME=FraudGraph
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_RESTPP_PORT=9000
TG_GS_PORT=14240
# Use separate Google Cloud projects for independent free-tier quota.
GEMINI_API_KEY=
GEMINI_EMBEDDING=
# Empty chain discovers and orders all supported text models automatically.
GEMINI_MODEL_CHAIN=
USE_LOCAL=0
EMBED_LIMIT=1500
EMBED_PROVIDER=all
# EmbeddingGemma: auto uses CUDA when available; cpu forces CPU, cuda falls back if unavailable.
EMBED_DEVICE=auto
# Optional existing FastEmbed BGE ONNX directory for policy uploads; never downloads weights.
# FRAUDLOOP_BGE_MODEL_PATH=/path/to/existing/bge-base-en-v1.5
MODEL_REGISTRY_PATH=data/model_registry.json
QUOTA_STATE_PATH=data/quota_state.json
# Optional, required only for gated EmbeddingGemma weights after accepting terms:
HF_TOKEN=
